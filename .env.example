# Database
DATABASE_URL=postgresql://newsreader:newsreader@localhost:5432/newsreader

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-me-to-a-random-string
JWT_REFRESH_SECRET=change-me-to-another-random-string
ENCRYPTION_KEY=change-me-32-char-hex-string-here

# App
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Registration mode: 'open' or 'invite'
REGISTRATION_MODE=open

# Public URL (used in emails and push notifications)
APP_URL=http://localhost:5173

# Email digest delivery (optional — leave blank to disable)
# Works with any SMTP provider: Resend, SendGrid, Mailgun, Postmark, Gmail, etc.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# SMTP_FROM=noreply@yourdomain.com

# Web Push notifications (optional — leave blank to disable)
# Generate VAPID keys with: npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:admin@yourdomain.com

# Error tracking (optional)
# SENTRY_DSN=https://...@sentry.io/...
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Process role for multi-instance deployments:
#   'all'    - single process (default for dev/personal use)
#   'web'    - HTTP server only, no background workers
#   'worker' - workers only (run alongside one or more 'web' processes)
# PROCESS_ROLE=all
